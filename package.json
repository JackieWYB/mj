{
  "name": "kwx-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.build.json",
    "test": "npm run build:test && node --test .tmp-test/test/engine.test.js",
    "server:dev": "npm run dev -w @kwx/server",
    "server:build": "npm run build -w @kwx/server",
    "server:start": "npm run start -w @kwx/server"
  }
}
